# ==========================================
# VARIABLES GLOBALES PARA DOCKER COMPOSE
# ==========================================

# Zona horaria para que los logs y bases de datos tengan la hora correcta local
TZ=America/Santiago

# ==========================================
# GRAFANA
# ==========================================
# Credenciales para entrar al dashboard de Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_smarthome_2026

# ==========================================
# N8N (AGENTE AUTÓNOMO)
# ==========================================
# Clave de encriptación para n8n (usada para guardar credenciales internas de forma segura)
# Puedes usar cualquier cadena de texto aleatoria.
N8N_ENCRYPTION_KEY=clave_secreta_equipo_hector_12345

# ==========================================
# FACE-SERVICE / PREDICCIÓN
# ==========================================
# Tiempo en segundos cada cuánto se ejecuta el script de predicción (600 seg = 10 minutos)
PREDICCION_INTERVALO_SEGUNDOS=600